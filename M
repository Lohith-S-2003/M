3) LOGICAL COMPARISON OPERATOR






use prg3

db.p3.insertMany([
{_id:1,name:"Laptop",category:"Electronics",price:60000,stock:15,rating:4.5},
{_id:2,name:"Mobile",category:"Electronics",price:40000,stock:25,rating:4.2}
])

db.p3.find({price:{$gt:50000}})

db.p3.find({stock:{$lt:20}})

db.p3.find({price:{$gt:10000,$lte:40000}})

db.p3.find({category:{$ne:"Electronics"}})

db.p3.find({category:"Electronics",price:{$gt:40000}})

db.p3.find({price:{$gte:50000}})

db.p3.find({rating:{$gte:4.2},price:{$lt:40000}})

db.p3.find({$or:[{price:{$lt:9000}},{stock:{$lt:5}}]})






4)   AGREGATE





use prg4

db.p4.insertMany([
{product:"Rice",quantity:10,price:60},
{product:"Sugar",quantity:5,price:45},
{product:"Oil",quantity:3,price:150},
{product:"Soap",quantity:8,price:30},
{product:"Milk",quantity:6,price:25}
])

db.p4.aggregate([
{$match:{product:"Rice"}},
{$group:{
_id:"$product",
totalSales:{
$sum:{$multiply:["$quantity","$price"]}
}
}}
])






