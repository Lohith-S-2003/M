2) INSERT AND RETRIVE EMBEDEED




use prg2

db.p2.insertMany([
{
order_id:101,
customer:{name:"A"},
items:[
{product:"Laptop"},
{product:"Mouse"}
]
},
{
order_id:102,
customer:{name:"B"},
items:[
