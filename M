6)   Insert and Update Array Fields





use prg6

db.p6.insertMany([
{course_id:"CS101",instructors:["Dr. Kumar"],topics:["Variables","Loops"]},
{course_id:"CS201",instructors:["Dr. Rao"],topics:["Arrays","Queues"]}
])

db.p6.updateOne(
{course_id:"CS101"},
{$push:{topics:"Recursion"}}
)

db.p6.updateOne(
{course_id:"CS201"},
{$push:{topics:{$each:["Trees","Graphs"]}}}
)

db.p6.updateOne(
{course_id:"CS101"},
{$addToSet:{instructors:"Dr. Kumar"}}
)

db.p6.updateOne(
{course_id:"CS101",topics:"Loops"},
{$set:{"topics.$":"Iteration"}}
)

db.p6.updateOne(
{course_id:"CS201"},
{$pull:{topics:"Queues"}}
)

db.p6.find()






7)   Upsert Option in MongoDB





use prg7

db.p7.insertOne({
studentId:1,
theme:"light",
notifications:false
})

db.p7.updateOne(
{studentId:1},
{$set:{theme:"dark",notifications:true}},
{upsert:true}
)

db.p7.updateOne(
{studentId:2},
{$set:{theme:"dark",notifications:true}},
{upsert:true}
)

db.p7.find()






8)   bulkWrite() Operations





use prg8

db.p8.insertMany([
{_id:1,name:"A",dept:"CSE",marks:75},
{_id:2,name:"B",dept:"ECE",marks:65},
{_id:3,name:"C",dept:"IT",marks:80}
])

db.p8.bulkWrite([

{insertOne:{document:{_id:4,name:"D",dept:"CSE",marks:70}}},

{updateOne:{filter:{name:"A"},update:{$set:{marks:85}}}},

{updateMany:{filter:{dept:"CSE"},update:{$inc:{marks:5}}}},

{replaceOne:{filter:{name:"B"},replacement:{name:"B",dept:"ECE",marks:72}}},

{deleteOne:{filter:{name:"C"}}}

])

db.p8.find()







9)    Schema Validation using $jsonSchema






use prg9

db.createCollection("students",{
validator:{
$jsonSchema:{
bsonType:"object",

required:["name","usn","age","course"],

properties:{
name:{bsonType:"string"},

usn:{bsonType:"string"},

age:{bsonType:"int",minimum:18,maximum:35},

course:{bsonType:"string"},

marks:{bsonType:"double",minimum:0,maximum:100}
}
}
}
})

db.students.insertOne({
name:"Rahul",
usn:"MCA001",
age:22,
course:"MCA",
marks:85.5
})

db.students.insertOne({
name:"Anita",
age:15,
course:"MCA"
})


